@inherits LayoutComponentBase


    
<FluentLayout NavigationDeferredLoading="true">

    @* ------------------- *@
    @*       Header        *@
    @* ------------------- *@
    <FluentLayoutItem Class="no-print" Area="@LayoutArea.Header" Height="44px">
        <FluentStack VerticalAlignment="@VerticalAlignment.Center" HorizontalGap="4px" Height="100%">
            @* Hamburger on Mobile *@
            <FluentLayoutHamburger @ref="@_hamburger" Style="margin: 2px 12px;" PanelHeader="HSTrend" Display="HamburgerDisplay.DesktopMobile" />

            HSTrend

            <FluentSpacer />


            @* DarkTheme *@
            <FluentButton IconStart="@(new Icons.Regular.Size20.DarkTheme().WithColor("var(--colorNeutralForegroundOnBrand)"))"
                          OnClick="@SwitchThemeAsync"
                          Appearance="ButtonAppearance.Transparent"
                          Title="Switch to Light/Dark theme" />


        </FluentStack>
    </FluentLayoutItem>

    @* ------------------- *@
    @*     Left menu       *@
    @* ------------------- *@

    <FluentLayoutItem Class="no-print" Area="@LayoutArea.Navigation" Width="262px" Sticky="true" Height="var(--layout-body-height)"
                      Style="overflow-y: auto; padding: 0px; border-right: var(--strokeWidthThin) solid var(--colorNeutralStroke1);">
        <NavMenu />
    </FluentLayoutItem>

    @* ------------------- *@
    @*       Body          *@
    @* ------------------- *@


    <FluentLayoutItem Area="@LayoutArea.Content" Class="demo-home">
        <div class="container-fluid p-3">
            @Body
        </div>
    </FluentLayoutItem>


    @* ------------------- *@
    @*       Footer        *@
    @* ------------------- *@

    <FluentLayoutItem Class="no-print" Area="LayoutArea.Footer" Padding="@Padding.All0">

        <!-- Version and copyright -->
        <FluentStack VerticalAlignment="@VerticalAlignment.Center"
                     Padding="@Padding.All2"
                     HorizontalGap="12px"
                     Style="font-size: smaller;">

            <FluentSpacer />
            <div>
                BlazorForms: @AppVersion.Version
            </div>
        </FluentStack>
    </FluentLayoutItem>

</FluentLayout>

    


<!-- FluentUI Service Providers -->
<FluentProviders />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private FluentLayoutHamburger _hamburger = default!;

    [Inject]
    public required IJSRuntime JSRuntime { get; set; }

    private async Task SwitchThemeAsync()
    {
        await JSRuntime.InvokeVoidAsync("Blazor.theme.switchTheme");
    }
}

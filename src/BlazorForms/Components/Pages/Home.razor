@page "/"
@using System.Globalization
@inherits BlazorFormsPageBase
<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@if (CurrentUser is null)
{
    <p>CurrentUser: NULL</p>
}
else
{
    <p>CurrentUser: @CurrentUser.DisplayName (@CurrentUser.UserId)</p>
}

<p>Culture: @CultureInfo.CurrentCulture.NativeName</p>
